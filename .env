APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-to-a-random-secret

BASE_LOCAL_URL=http://spending-tracker-webserver
DATABASE_URL="postgresql://spending_tracker:spending_tracker@db:5432/spending_tracker?serverVersion=16&charset=utf8"

# Invite-only signup. Empty (default) means /signup is open to anyone. Set by
# scripts/enable_invite_only.sh into .env.local - never commit a real value here.
# A random value requires ?invite=<value> on /signup; the literal value "disabled"
# turns /signup off entirely.
INVITE_SECRET=
